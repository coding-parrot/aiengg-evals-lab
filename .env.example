# INSTRUCTOR ONLY: copy to .env locally or use hosting secrets. Never commit .env.
OPENAI_API_KEY=
# Both bot and typed decision judge reuse the same OpenAI key.
OPENAI_MODEL=gpt-6-luna
JUDGE_PROVIDER=openai_decisions
DECISIONS_MODEL=gpt-6-luna
# Optional legacy Jev switch only: JUDGE_PROVIDER=jev plus TYPESAFE_API_KEY/JEV_MODEL.
COHORT_PUBLIC_URL=http://localhost:8787
HOST=127.0.0.1
PORT=8787
COHORT_STATE_DIR=private-data/cohort-state
# Lifetime call ceilings; each generation/Jev request counts, including failures.
COHORT_MAX_CALLS=20000
COHORT_STUDENT_MAX_CALLS=5000
COHORT_CALLS_PER_MINUTE=120
COHORT_CONCURRENCY=4
COHORT_MAX_INPUT_BYTES=24000
COHORT_MAX_OUTPUT_TOKENS=1200
# Optional dated pricing; leave absent for unknown serving cost, never assumed zero.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# LANGSMITH_API_KEY=  # Added at the separately triggered monitoring checkpoint.
# Students instead download a private .env containing COHORT_URL/COHORT_ACCESS_TOKEN.
